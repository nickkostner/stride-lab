# Copy to .env and fill in. Keep this file private.
HOST_IP=192.168.1.20          # LAN IP of the computer plugged into the TV

# Only for --profile wyze
WYZE_EMAIL=you@example.com
WYZE_PASSWORD=change-me
WYZE_API_ID=                  # from developer-api-console.wyze.com
WYZE_API_KEY=
WYZE_CAMERA_NAME=Treadmill    # the camera's nickname in the Wyze app
